{
    "name": "rennf93/laravel-guard-example-advanced",
    "description": "Production-shaped guarded app demonstrating rennf93/laravel-guard",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "rennf93/laravel-guard": "dev-master",
        "rennf93/guard-core-php": "^4.0.4 || dev-master",
        "illuminate/http": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/rennf93/guard-core-php"
        },
        {
            "type": "vcs",
            "url": "https://github.com/rennf93/laravel-guard"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
